# ⚠️ Это ОБРАЗЕЦ. Реальные значения впишите в файл `.env` (он не попадает в git).
# Никогда не коммитьте настоящие токены и пароли — репозиторий публичный.

# --- Авторизация в платформе ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Случайная строка для подписи сессионных cookie (обязательно смените в проде)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Telegram (публикация через Bot API) ---
# 1) Создайте бота у @BotFather, 2) добавьте его админом в канал
TELEGRAM_BOT_TOKEN=
# ID или @username канала, например @sayyoh_travel
TELEGRAM_CHANNEL_ID=

# --- Claude API (генерация текстов постов агентом) ---
# Без ключа агент использует встроенные шаблоны
ANTHROPIC_API_KEY=
# Модель по умолчанию claude-opus-4-8
ANTHROPIC_MODEL=

# --- Рендер обложек в PNG ---
# Путь к бинарнику Chrome/Chromium. Если пусто — берётся из реестра Playwright
# (npx playwright-core install chromium)
CHROMIUM_PATH=

# --- Планировщик автопубликации ---
# Если задан — /api/cron требует заголовок Authorization: Bearer <секрет>
CRON_SECRET=
